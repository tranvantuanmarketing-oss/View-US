# Reels Studio V2 Environment Variables Example
# Duplicate this file to .env.local and fill in your actual values.
# NEVER commit .env or .env.local to git.

# Server Authentication & Session Security (HMAC signed cookies)
SESSION_SECRET="your-32-character-random-session-secret-key-here"

# Public App URL (used for helper install scripts and asset links)
NEXT_PUBLIC_APP_URL="http://localhost:3020"

# Supabase Configuration
# Server-only keys MUST NOT have NEXT_PUBLIC_ prefix!
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# AI Card Writer (Anthropic Claude API)
ANTHROPIC_API_KEY="your-anthropic-api-key"
CLAUDE_MODEL="claude-opus-5-5"

# Render Helper Daemon Security
RENDER_HELPER_SECRET_SALT="your-secret-salt-for-machine-keys"
